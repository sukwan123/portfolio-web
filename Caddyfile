# Railway 는 $PORT 를 주입한다. 로컬 테스트는 8080.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# 이미지·영상은 오래 캐시
	@media path *.jpg *.jpeg *.png *.webp *.mp4 *.woff2
	header @media Cache-Control "public, max-age=31536000, immutable"

	# HTML·CSS·JS 는 배포할 때마다 바뀌므로 항상 재검증
	@doc path *.html *.css *.js /
	header @doc Cache-Control "public, max-age=0, must-revalidate"

	# 검색엔진 비노출
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"

	file_server
}
